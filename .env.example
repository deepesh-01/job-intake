# Path to Google service-account JSON. The service account must be
# granted Editor on the target Sheet.
GOOGLE_SHEETS_CREDS_PATH=/Users/me/secrets/job-intake-sa.json

# Sheet ID. The long token from the Sheet URL between /d/ and /edit.
SHEET_ID=replace-me

# Project paths. Use absolute paths.
DATA_DIR=/Users/me/code/job-intake/data
TAG_RULES_PATH=/Users/me/code/job-intake/tag_rules.yaml
BOARDS_PATH=/Users/me/code/job-intake/boards.yaml
EXCLUDE_PATH=/Users/me/code/job-intake/exclude.yaml

# System A (Resume Tailoring Agent) repo root. tailor_bridge.py invokes
# `node $SYSTEM_A_PATH/dist/cli.js tailor ...` per design doc §13.8.
SYSTEM_A_PATH=/Users/me/code/resume-bot

# Base resume path that System A will read. Owned by System A.
SYSTEM_A_BASE_RESUME=/Users/me/code/resume-bot/data/base_resume.md

# When true, tailor_bridge skips the subprocess and writes a stub PDF.
# Useful for validating the Sheet flow without burning Claude API budget.
TAILOR_DRY_RUN=true

# OPTIONAL — if set, the Processor uploads each tailored PDF to this
# Drive folder and writes the shareable Drive URL to the Sheet's
# `resume_path` cell instead of a local filesystem path. Leave blank
# for local-only mode.
# Setup: create a Drive folder, share with the SA email as Editor,
# copy the folder ID from the URL.
GOOGLE_DRIVE_FOLDER_ID=

# Need to have:
#   SYSTEM_A_USER_CHAT_ID=<your Telegram chat id, used to find your base_resume>

LOG_LEVEL=INFO
